# Detect the Atheros AR9271 WiFi adapter and ensure the driver binds.
# After KVM switches or port changes, the ath9k_htc driver can fail to claim
# the device. The systemd service retries with a USB re-probe if needed.
# Disable USB autosuspend — the 2s default causes the adapter to hardware-sleep,
# dropping the camera's WiFi AP association.
# (Replaced the original MT7601U 148f:7601, whose receiver failed 2026-09.)
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0cf3", ATTR{idProduct}=="9271", TAG+="systemd", ENV{SYSTEMD_WANTS}="teleprompter-wifi-rebind.service", ATTR{power/control}="on"
