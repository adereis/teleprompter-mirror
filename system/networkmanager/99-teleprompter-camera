#!/bin/bash
# NetworkManager dispatcher script for camera WiFi.
#
# Events:
#   up           — WiFi connected: initialize Smart Remote, start keepalive
#   down         — WiFi lost: stop keepalive, log for retrospective analysis
#   dhcp4-change — DHCP lease changed: log WiFi station metrics, then verify
#                  camera state via `start` (recovers Smart Remote iff the
#                  camera reports NotReady). Skips if `up` already handled it.

IFACE="$1"
ACTION="$2"

[ "$CONNECTION_ID" = "__CAMERA_CONNECTION__" ] || exit 0

LOCK="/run/teleprompter-camera-up"
XDG_DIR="/run/user/$(id -u __USER__)"

log() { logger -t teleprompter-camera "$@"; }

log_wifi_metrics() {
    local dump
    dump=$(iw dev "$IFACE" station dump 2>/dev/null) || return
    local inactive signal rx_bytes tx_bytes tx_retries tx_failed beacon_loss
    inactive=$(echo "$dump" | awk '/inactive time:/{print $3}')
    signal=$(echo "$dump" | awk '/signal:/{print $2; exit}')
    rx_bytes=$(echo "$dump" | awk '/rx bytes:/{print $3}')
    tx_bytes=$(echo "$dump" | awk '/tx bytes:/{print $3}')
    tx_retries=$(echo "$dump" | awk '/tx retries:/{print $3}')
    tx_failed=$(echo "$dump" | awk '/tx failed:/{print $3}')
    beacon_loss=$(echo "$dump" | awk '/beacon loss:/{print $3}')
    log "$IFACE: inactive=${inactive}ms signal=${signal}dBm rx=${rx_bytes}B tx=${tx_bytes}B retries=${tx_retries} failed=${tx_failed} beacon_loss=${beacon_loss}"
}

run_reconnect() {
    runuser -u __USER__ -- __PROJECT_DIR__/camera/camera-control.py reconnect 2>&1 \
        | logger -t teleprompter-camera &
}

run_start() {
    runuser -u __USER__ -- __PROJECT_DIR__/camera/camera-control.py start 2>&1 \
        | logger -t teleprompter-camera &
}

keepalive_start() {
    if runuser -u __USER__ -- env XDG_RUNTIME_DIR="$XDG_DIR" \
        systemctl --user start teleprompter-camera-keepalive.service; then
        log "Keepalive started"
    else
        log "Keepalive failed to start"
    fi
}

keepalive_stop() {
    runuser -u __USER__ -- env XDG_RUNTIME_DIR="$XDG_DIR" \
        systemctl --user stop teleprompter-camera-keepalive.service 2>/dev/null || true
}

case "$ACTION" in
    up)
        log "Camera WiFi connected on $IFACE — initializing"
        log_wifi_metrics
        touch "$LOCK"
        { sleep 30; rm -f "$LOCK"; } &
        run_reconnect
        keepalive_start
        ;;
    down)
        log "Camera WiFi disconnected on $IFACE"
        rm -f "$LOCK"
        keepalive_stop
        ;;
    dhcp4-change)
        log_wifi_metrics
        if [ -f "$LOCK" ]; then
            log "DHCP after up on $IFACE — skipping (up handler already recovering)"
            rm -f "$LOCK"
        else
            # A DHCP change can follow a re-association without a full down/up
            # cycle (brief blip), and power-loss drops don't even leave a
            # kernel 'disassociated' line — they log 'authentication timed
            # out'. So don't guess the drop type from kernel logs: ask the
            # camera. `start` is self-gating — it runs startRecMode + zoom
            # restore only if getEvent reports NotReady, otherwise it just logs
            # the state and exits. One cheap read-only poll per renewal.
            log "DHCP change on $IFACE — verifying camera state"
            run_start
        fi
        ;;
esac
