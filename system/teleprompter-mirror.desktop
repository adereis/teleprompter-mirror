[Desktop Entry]
Name=Teleprompter Mirror
Comment=Mirror a window to the tablet for eye contact during calls
Exec=__PROJECT_DIR__/bin/open-cast.sh
Icon=video-display
Type=Application
Categories=Utility;
Actions=focus-shared;

[Desktop Action focus-shared]
Name=Focus Shared Window
Exec=__PROJECT_DIR__/bin/focus-shared.sh
